# ─── Frontend (Vite) environment ─────────────────────────────
# Copy to `.env` for local dev, or set these in your host's build env.
# Only VITE_-prefixed vars are exposed to the browser bundle.

# Base URL of the VitalLens API server (no trailing slash, no /api suffix —
# callers append /api/... themselves). Defaults to the local dev server when
# unset. In production point this at the deployed API origin.
# Example: VITE_API_BASE=https://api.vitallens.app
VITE_API_BASE=http://localhost:3001

# NOTE: server-side secrets (Supabase service role key, OpenAI/Anthropic keys,
# Upstash, Stripe, etc.) live in server/.env — never prefix those with VITE_ or
# they will be bundled into the public frontend.

# Supabase (public anon key — safe to expose; RLS protects data). Defaults are
# baked into src/lib/supabase.js for local dev; set these for a different project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web push (optional). Pairs with the server's VAPID_PUBLIC_KEY; leave empty to keep reminders local-only.
VITE_VAPID_PUBLIC_KEY=

# Product analytics (optional). PostHog is bundled and loads only when a key is set.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
